# Copy to .env.local (already created for the local build).
NEXT_PUBLIC_API_URL=http://localhost:4000
BACKEND_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MediaDL

# ── Optional integrations — leave blank to disable ──────────────────────────
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Cloudflare Turnstile site key (pair with TURNSTILE_SECRET_KEY in the root .env)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
