# The bot reads the repo-root .env first, then this file (this one wins on
# conflicts). For the normal local setup just fill in the two values in the
# repo-root .env — you don't need this file at all.

# TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# TELEGRAM_ALLOWED_USERS=11111111,22222222
# TELEGRAM_ADMINS=11111111
# TELEGRAM_ALLOW_ALL=false

# Where the MediaDL Express backend is (default http://localhost:4000)
# BOT_BACKEND_URL=http://localhost:4000

# Public base URL for download links handed to chat (default = backend url)
# BOT_PUBLIC_BASE_URL=https://mediadl.example.com

# Upload cap. 49 for the stock Bot API, ~1950 behind a local telegram-bot-api.
# TELEGRAM_MAX_UPLOAD_MB=49
# TELEGRAM_API_ROOT=http://localhost:8081

# Default download options (overridable per-user with /settings)
# BOT_DEFAULT_QUALITY=best
# BOT_DEFAULT_VIDEO_FORMAT=mp4
# BOT_DEFAULT_AUDIO_FORMAT=mp3
